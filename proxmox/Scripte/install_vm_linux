#!/bin/bash
#
# Vorlage zum Erzeugen einer Linux-VM unter Proxmox (Zion)
#
# Ausführbar-Bit setzen
# chmod +x install_vm_linux
#
# Ausführen
# ./install_vm_linux
#
# Überprüfung der Syntax ohne etwas auszuführen
# bash -n install_vm_linux


# ─── Konfiguration ─────────────────────────────────────────────────
VMID=400            						# freie ID wählen
NAME=kali-linux								# VM Name
ISO=kali-linux-2026.2-installer-amd64.iso
STORAGE=vm-storage-fast 					# dein Disk-Storage
ISO_STORAGE=local        					# wo die ISO liegt

SOCKETS=1
CORES=4
MEMORY=8192
DISK=60
# ───────────────────────────────────────────────────────────────────
# Prüfen, ob die VMID schon vergeben ist
if qm status "$VMID" &>/dev/null; then
  echo "Fehler: VMID $VMID ist bereits vergeben. Bitte eine freie ID wählen."
  exit 1
fi

qm create $VMID \
  --name $NAME \
  --machine q35 \
  --bios seabios \
  --ostype l26 \
  --cpu host \
  --sockets $SOCKETS --cores $CORES \
  --memory $MEMORY --balloon 0 \
  --scsihw virtio-scsi-single \
  --net0 virtio,bridge=vmbr0,firewall=1 \
  --agent enabled=1 \
  --vga qxl

# Systemdisk 60 GB mit SSD-Emu, Discard, IO-Thread
qm set $VMID --scsi0 ${STORAGE}:$DISK,ssd=1,discard=on,iothread=1

# ISO als CD-ROM
qm set $VMID --ide2 ${ISO_STORAGE}:iso/$ISO,media=cdrom

# Bootreihenfolge: erst CD, dann Disk
qm set $VMID --boot order='ide2;scsi0'